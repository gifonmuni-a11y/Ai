# ===== MODEL PROVIDER KEYS =====
# Groq (gratis) — dibutuhkan untuk pre-flight intent detection & chat model
GROQ_API_KEY=gsk_xxx
# Groq key CADANGAN #1 — otomatis dipakai saat key utama kena rate limit (429) selama 10 menit
GROQ_API_KEY_BACKUP=gsk_xxx
# Groq key CADANGAN #2 — dipakai jika backup #1 juga kena limit
GROQ_API_KEY_BACKUP2=gsk_xxx
# OpenRouter — model cadangan & image gen
OPENROUTER_API_KEY=sk-or-v1-xxx
# OpenRouter key CADANGAN — otomatis dipakai saat key utama kena rate limit (429)
OPENROUTER_API_KEY_BACKUP=sk-or-v1-xxx
# Gemini — model cadangan (opsional)
#GEMINI_API_KEY=xxx

# ===== SUPABASE (opsional, untuk sesi/chat tersimpan) =====
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxx

# ===== TTS TikTok (opsional) =====
TIKTOK_TTS_URL=https://tiktok-tts.weilnet.workers.dev/api/generation
TIKTOK_TTS_VOICE=jp_001
# TikTok TTS diprioritaskan; timeout besar (25s) agar tidak cepat jatuh ke Edge
TIKTOK_TTS_TIMEOUT=25000
TIKTOK_TTS_URL_OFFICIAL=https://api16-normal-c-useast1a.tiktokv.com/media/api/text/speech/invoke/
TIKTOK_TTS_VOICE_ID=id_001

# ===== AI Horde (opsional, model gratis) =====
AIHORDE_API_KEY=xxx

# ===== ADMIN =====
ADMIN_MASTER_PASS=GANTI_KATA_SANDI
SENKA_ACCESS_CODE=GANTI_KODE_AKSES

# ===== Hybrid Agentic RAG (Web Search) =====
# Tavily — PRIMARY web search untuk intent GENERAL.
# Buat key gratis di https://app.tavily.com (dashboard) lalu tempel di sini.
TAVILY_API_KEY=tvly-xxx

# Exa AI — SECONDARY web search, otomatis dipakai jika Tavily gagal / kena limit.
# Buat key gratis di https://dashboard.exa.ai lalu tempel di sini.
EXA_API_KEY=xxx

# ===== HuggingFace (musik: dipakai langsung di frontend script.js, lihat HF_TOKEN_FRONT) =====
# ===== TensorArt (video, server-side) =====
TENSORART_API_KEY=
